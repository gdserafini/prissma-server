# Copie para `.env` na raiz do projeto e preencha os valores.
# O `.env` e lido pelo spring-dotenv no start e NAO vai para o repositorio.
#
# Sem OPENAI_API_KEY a geracao de imagens responde 503 com a mensagem
# "A integracao de imagens esta sem OPENAI_API_KEY configurada". O resto da
# aplicacao sobe normalmente.

# Chave da OpenAI usada pela previa de ambiente por IA (pacote genai).
OPENAI_API_KEY=

# Opcionais - so preencha para apontar para outro endpoint ou modelo.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_MAX_INPUT_BYTES=20971520
